{
  "uid": "oreflow-northpit",
  "title": "OreFlow 2.0 \u2014 24h Dispatch & Fuel Digital Twin",
  "tags": [
    "openegiz",
    "oreflow",
    "northpit"
  ],
  "schemaVersion": 39,
  "refresh": "5s",
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Delivered ore \u2022 tonnes",
      "datasource": {
        "type": "influxdb",
        "uid": "opentwins-influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "none"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "opentwins-influxdb"
          },
          "query": "from(bucket: \"default\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r.thingId == \"org.openegiz.oreflow:mine-01\" and r._field == \"value_delivered_t_properties_value\") |> keep(columns: [\"_time\", \"_value\"])"
        }
      ]
    },
